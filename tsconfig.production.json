{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".next-production/types.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "hooks/**/*.ts",
    ".next-production/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".vinext", "dist", "out"]
}
